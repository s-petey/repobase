{
  "name": "repobase",
  "version": "1.3.0",
  "description": "Index and search your repositories with AI. Includes TUI and MCP server.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "repobase": "./dist/bin/repobase.js",
    "repobase-mcp": "./dist/bin/repobase-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev:tui": "bun run --cwd packages/tui start",
    "dev:mcp": "bun run --cwd packages/mcp-server start",
    "test": "bun run --cwd packages/engine test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "repository",
    "search",
    "semantic-search",
    "tui",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandoabolafio/repobase.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.93.6",
    "@effect/platform-bun": "^0.86.0",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "@types/bun": "^1.4.2",
    "@xenova/transformers": "^2.17.2",
    "effect": "^3.19.9",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  }
}
