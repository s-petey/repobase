{
  "name": "repobase",
  "version": "1.3.0",
  "description": "Index and search your repositories with AI. Includes TUI and MCP server.",
  "keywords": [
    "cli",
    "mcp",
    "model-context-protocol",
    "repository",
    "search",
    "semantic-search",
    "tui"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandoabolafio/repobase.git"
  },
  "bin": {
    "repobase": "./dist/bin/repobase.js",
    "repobase-mcp": "./dist/bin/repobase-mcp.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev:tui": "bun run --cwd packages/tui start",
    "dev:mcp": "bun run --cwd packages/mcp-server start",
    "dev:cli": "bun run --cwd packages/cli start",
    "test": "bun --bun vitest",
    "prepublishOnly": "bun run build",
    "check": "bun run --workspaces --sequential check",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@effect/platform": "^0.93.6",
    "@effect/platform-bun": "^0.86.0",
    "@lancedb/lancedb": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentui/core": "0.4.2",
    "@opentui/react": "0.4.2",
    "@types/bun": "^1.3.5",
    "@xenova/transformers": "^2.17.2",
    "effect": "^3.19.9",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.5",
    "react": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "semantic-release": "^24.2.0",
    "typescript": "^5.9.3",
    "vitest": "3.0.0",
    "website": "^0.1.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
