{
  "name": "repobase",
  "version": "1.3.0",
  "description": "Index and search your repositories with AI. Includes TUI and MCP server.",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.1.0",
      "@effect/vitest": "4.1.0",
      "@huggingface/transformers": "^4.3.1",
      "@lancedb/lancedb": "^0.39.0",
      "@modelcontextprotocol/client": "^2.3.1",
      "@modelcontextprotocol/server": "^2.3.1",
      "@opentui/core": "^0.5.17",
      "@opentui/react": "^0.5.17",
      "@types/react": "^19.3.0",
      "effect": "4.1.0",
      "fast-glob": "^3.3.3",
      "micromatch": "^4.0.8",
      "react": "^19.3.1",
      "typescript": "^7.0.2"
    }
  },
  "bin": {
    "repobase": "./dist/bin/repobase.js",
    "repobase-mcp": "./dist/bin/repobase-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev:tui": "bun run --cwd packages/tui start",
    "dev:mcp": "bun run --cwd packages/mcp-server start",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "check": "bun run --filter './packages/*' check",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "repository",
    "search",
    "semantic-search",
    "tui",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandoabolafio/repobase.git"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "@huggingface/transformers": "^4.3.1",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentui/core": "^0.5.17",
    "@opentui/react": "^0.5.17",
    "@types/bun": "^1.4.4",
    "effect": "4.1.0",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  }
}
